PORT=3000

# LiveKit Credentials
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=ws://127.0.0.1:7880

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=view360
# Or full connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/view360

# Firebase Cloud Messaging (FCM) Configuration
# Option 1: File path to service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=src/credentials/v360chatnotification-firebase-adminsdk-fbsvc-5e244b5c06.json
# Option 2: Full JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Option 3: Individual credentials
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
